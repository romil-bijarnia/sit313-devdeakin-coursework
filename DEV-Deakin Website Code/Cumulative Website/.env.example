# Server configuration for a root .env file.
PORT=5050
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Resend is preferred when configured. Its default test sender is
# DEV@Deakin <onboarding@resend.dev>; set RESEND_FROM after verifying a domain.
RESEND_API_KEY=
RESEND_FROM=

# SendGrid is used when Resend is not configured and both values below are set.
SENDGRID_API_KEY=
SENDGRID_FROM=

# Leave VITE_API_BASE empty for same-origin /api calls on Netlify. Local Vite
# automatically uses http://127.0.0.1:5050 when this value is empty.
VITE_API_BASE=

# Export these for the Vite process or copy them into frontend/.env.
VITE_FIREBASE_API_KEY=replace-with-your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=replace-with-your-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-your-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-your-web-app-id
