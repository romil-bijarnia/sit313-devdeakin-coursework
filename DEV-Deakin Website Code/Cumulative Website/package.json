  "private": true,
  "description": "Cumulative SIT313 DEV@Deakin React, Firebase, Express, and Netlify application.",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run frontend\"",
    "frontend": "vite --host 127.0.0.1 --port 5173 frontend",
