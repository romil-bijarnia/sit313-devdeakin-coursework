    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "vite": "^6.0.3"
  }
