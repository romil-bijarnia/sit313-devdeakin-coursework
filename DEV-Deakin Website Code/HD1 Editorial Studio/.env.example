FIRESTORE_PROJECT_ID=sit313-p4-1bade
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/credential.json
JWT_SECRET=replace-with-a-random-server-secret-of-at-least-32-characters
PORT=5178
SITE_ORIGIN=http://127.0.0.1:5178
HOST=127.0.0.1
# Trusted comma-separated account emails; users cannot select their own role.
MODERATOR_EMAILS=
# Server-only Gmail OAuth settings. Authorize the sender with gmail.send and offline access.
NEWSLETTER_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# Optional legacy provider: only used with NEWSLETTER_PROVIDER=sendgrid.
SENDGRID_API_KEY=
NEWSLETTER_FROM_EMAIL=
# Legacy SENDGRID_FROM_EMAIL remains supported when NEWSLETTER_FROM_EMAIL is blank.
# Optional secret JSON alternative for the local server; required in Netlify Functions runtime settings.
# Configure securely outside source control. Do not prefix server secrets with VITE_.
FIRESTORE_SERVICE_ACCOUNT_JSON=
