{
  "name": "sit313-hd1-editorial-workflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Proposed DEV@Deakin editorial workflow prototype.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --import tsx server/index.ts\" \"vite\"",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:firestore": "node --env-file-if-exists=.env --import tsx scripts/verify-firestore.ts",
    "check:publish": "node --import tsx scripts/check-publish.ts",
    "check:function": "node --import tsx scripts/check-function.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.0.1",
    "@netlify/aws-lambda-compat": "^2.0.0",
    "@netlify/functions": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.1.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.3",
    "serverless-http": "^4.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
